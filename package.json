{
  "name": "ruby-knowledge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --filter @ruby/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm --filter @ruby/web typecheck && tsc --project tsconfig.tools.json",
    "test": "vitest run",
    "test:hooks": "node scripts/test-hooks.mjs",
    "test:e2e": "playwright test",
    "build": "pnpm --filter @ruby/web build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:hooks && pnpm secrets:check && pnpm build && pnpm test:e2e",
    "secrets:check": "secretlint \"**/*\"",
    "audit:deps": "pnpm audit --audit-level high"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "1.64.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "http-server": "14.1.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "secretlint": "13.0.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
